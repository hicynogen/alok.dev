{
  "name": "alok-cyber-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Alok Mishra's animated cyber portfolio with a persistent contact inbox",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "inbox": "node --env-file-if-exists=.env scripts/inbox.js",
    "prepare:assets": "node scripts/prepare-assets.js",
    "build": "node scripts/build-site.js",
    "build:preview": "node scripts/build-preview.js"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0"
  }
}
